{
  "name": "cme-utils",
  "version": "6.0.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "description": "A collection of utility functions for TypeScript/JavaScript",
  "author": "CME",
  "main": "./m/index.js",
  "types": "./m/index.d.ts",
  "exports": {
    ".": {
      "types": "./m/index.d.ts",
      "default": "./m/index.js"
    },
    "./ts": "./ts/index.ts",
    "./cjs/max-return-statements-per-function.rule.cjs": "./cjs/max-return-statements-per-function.rule.cjs",
    "./cjs/max-return-statements-per-function.plugin.cjs": "./cjs/max-return-statements-per-function.plugin.cjs",
    "./ts/max-return-statements-per-function.rule.ts": "./ts/max-return-statements-per-function.rule.ts",
    "./ts/max-return-statements-per-function.plugin.ts": "./ts/max-return-statements-per-function.plugin.ts",
    "./m/*.js": {
      "types": "./m/*.d.ts",
      "default": "./m/*.js"
    }
  },
  "files": [
    "m",
    "cjs",
    "ts"
  ],
  "keywords": [
    "util",
    "utils",
    "typescript",
    "javascript",
    "esm",
    "tree-shaking",
    "eslint"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clemeno/cme-utils.git"
  },
  "scripts": {
    "prepare": "bun run build",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch"
  },
  "engines": {
    "node": ">=16"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "eslint": "^9.39.4",
    "neostandard": "^0.13.0",
    "typedoc": "^0.28.18",
    "typescript": "^5.9.3"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
